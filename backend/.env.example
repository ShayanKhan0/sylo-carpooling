# Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/sylo_carpool
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=sylo_carpool
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT Configuration
SECRET_KEY=your-secret-key-here-generate-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=SmartCarpoolingApp
DEBUG=True

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# File Upload
UPLOAD_DIR=./static/uploads
MAX_UPLOAD_SIZE=10485760

# Google Maps (Places, Directions, Geocoding, Distance Matrix) — required for routes & map proxy
# Use either name; if both are set, GOOGLE_MAPS_API_KEY wins when GOOGLE_MAPS_KEY is empty.
GOOGLE_MAPS_KEY=
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Firebase Admin (REQUIRED for email/password login via /api/v1/auth/login)
# 1) Firebase Console → Project settings → Service accounts → Generate new private key → save JSON locally.
# 2) Point this path to that file (use forward slashes or escaped backslashes on Windows).
#    Example: FCM_CREDENTIALS_PATH=D:/secrets/sylo-firebase-adminsdk.json
# Alternative: set system env GOOGLE_APPLICATION_CREDENTIALS to the same JSON path.
FCM_CREDENTIALS_PATH=
# Must match your Firebase project (same as Flutter firebase_options / GoogleService-Info).
FIREBASE_PROJECT_ID=sylo-e895e

# === VERIFICATION FUNCTIONALITY START ===
# Verification AI Providers
# local: built-in mock adapters (no external APIs)
# google: Google Cloud Vision OCR
# azure: Azure Face verify/match
VERIFICATION_OCR_PROVIDER=google
VERIFICATION_FACE_PROVIDER=azure
VERIFICATION_REQUIRE_SELFIE_FOR_FACE_MATCH=true
VERIFICATION_FACE_MATCH_THRESHOLD=0.80

# Google Vision OCR
# Use the service account JSON created in Google Cloud Console.
GOOGLE_APPLICATION_CREDENTIALS=D:/FYP/Newfolder/sylo-vision-service-account.json
GOOGLE_CLOUD_PROJECT=your-google-project-id

# AWS Rekognition
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1

# Azure AI Vision / Face API
# Endpoint example: https://your-resource-name.cognitiveservices.azure.com
AZURE_VISION_ENDPOINT=
AZURE_VISION_API_KEY=
# Optional explicit Face resource (if different from Vision)
AZURE_FACE_ENDPOINT=
AZURE_FACE_API_KEY=
# === VERIFICATION FUNCTIONALITY END ===
